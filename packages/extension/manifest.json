{
  "manifest_version": 3,
  "name": "Agent Credential Broker",
  "version": "0.1.0",
  "description": "Fills logins approved on the local broker dashboard. Never exposes credentials to pages or agents.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Agent Credential Broker", "default_popup": "popup.html" }
}
